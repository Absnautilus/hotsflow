VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: enables Web Push -- both the Housekeeping on-duty toggle and
# Settings' own "Notifiche" device toggle. Both hide themselves when unset;
# the app runs fine without it.
VITE_VAPID_PUBLIC_KEY=

# Optional: the single shared domain apps/guest is deployed to (e.g.
# https://guesthotel.hotsflow.com, no trailing slash). Settings' "Link
# accesso ospiti" row hides itself when unset, since it can't build a real
# link without knowing this.
VITE_GUEST_APP_URL=
