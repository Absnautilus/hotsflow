VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# There is no VITE_HOTEL_ID here: this is one deployment shared by every
# hotel on one domain. Each hotel's own QR code/link carries its hotel id as
# a `?hotel=` URL param instead (see src/lib/env.ts).

# Optional: shows a "sei dello staff?" link on the login screen pointing at
# the staff shell's real URL. Omit to hide the link entirely.
VITE_STAFF_APP_URL=

# Optional: enables push notifications elsewhere in the platform; unused by
# the guest screens themselves today, kept for parity with apps/web/modules/housekeeping's .env.example.
VITE_VAPID_PUBLIC_KEY=
